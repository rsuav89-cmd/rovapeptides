# Public WooCommerce store URL (checkout + my-account redirects)
NEXT_PUBLIC_WC_CHECKOUT_URL=https://shop.rovapeptides.com

# WooCommerce REST API (server-only — set in Vercel, never commit real values).
# REQUIRED: /api/checkout creates the pending order through this API and returns
# the order's payment_url. Generate the pair in WooCommerce under
# WooCommerce → Settings → Advanced → REST API, with Read/Write permissions.
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional. Defaults to $WC_SHOP_URL/wp-json/wc/v3
WC_API_URL=https://shop.rovapeptides.com/wp-json/wc/v3
# Optional escape hatch: set to 1 ONLY if your host strips the Authorization
# header (symptom: every order request returns 401 woocommerce_rest_cannot_view).
# Credentials then travel as query parameters and will appear in access logs.
# WC_AUTH_IN_QUERY=1

# DEPRECATED as of the Order Pay migration. The signed-cart handoff and the
# rova-handoff mu-plugin are no longer used by /api/checkout; the store's
# session cookie is no longer part of the flow. Safe to remove once the new
# checkout is confirmed live in production.
# HANDOFF_SECRET=replace-with-a-long-random-secret
# Base URL of the WooCommerce store that receives the handoff (server-only).
WC_SHOP_URL=https://shop.rovapeptides.com
