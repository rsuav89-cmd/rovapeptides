# Public WooCommerce store URL (checkout + my-account redirects)
NEXT_PUBLIC_WC_CHECKOUT_URL=https://shop.rovapeptides.com

# WooCommerce REST API (server-only — set in Vercel, never commit real values)
WC_API_URL=https://your-store.example.com/wp-json/wc/v3
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Checkout handoff (signed cart transfer to WooCommerce)
# HANDOFF_SECRET must be IDENTICAL here (Vercel) and in wp-config.php on Hostinger.
# Generate one with:  openssl rand -hex 32
HANDOFF_SECRET=replace-with-a-long-random-secret
# Base URL of the WooCommerce store that receives the handoff (server-only).
WC_SHOP_URL=https://shop.rovapeptides.com
